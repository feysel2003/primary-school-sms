generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------
// GLOBAL SCHEMA (Super Admin Level)
// ---------------------------------------------------

// The 'Tenant' represents an independent School
model Tenant {
  id              String   @id @default(uuid())
  name            String   
  subdomain       String   @unique 
  status          String   @default("ACTIVE") 
  subscriptionEnd DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]   
  students        Student[] // A school has many students
  attendances     Attendance[]
  grades          Grade[]
}

// Global Users table (Admins, Teachers, Parents)
model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String   @unique 
  password     String
  role         Role     @default(PARENT) 
  language     String   @default("am") 
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references:[id], onDelete: Cascade)

  children     Student[] // <-- NEW: A parent can have multiple children!

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

// ---------------------------------------------------
// SCHOOL DATA SCHEMA
// ---------------------------------------------------

// The Student Model
model Student {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  gender      String   // "MALE" or "FEMALE"
  grade       String   // e.g., "KG1", "Grade 2"
  
  // Link to the Parent
  parentId    String
  parent      User     @relation(fields: [parentId], references: [id])

  // Link to the School
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attendances     Attendance[]
  grades          Grade[]
}

// The Daily Attendance Model
model Attendance {
  id        String   @id @default(uuid())
  date      DateTime @default(now()) // The day the roll call was taken
  status    String   // e.g., "PRESENT", "ABSENT", "LATE"
  
  // Link to the Student
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Link to the School (Tenant)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The Student Grades Model
model Grade {
  id              String   @id @default(uuid())
  subject         String   // e.g., "Math", "Amharic", "English"
  assessmentType  String   // e.g., "Test 1", "Midterm", "Final Exam"
  score           Float    // The mark the student got (e.g., 85.5)
  maxScore        Float    @default(100) // Out of what? (usually 100)
  term            String   // e.g., "Term 1", "Semester 1"
  
  // Link to the Student
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Link to the School (Tenant)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}